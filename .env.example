# =============================================================================
# wedding-site env vars
# Copy to .env.local for local dev. In production, set these in
# Cloudflare Pages > Settings > Environment variables.
# NEXT_PUBLIC_* are exposed to the browser (LIFF IDs and the OA add-friend URL
# are not secret). Everything else is server-side only (Pages Functions).
# =============================================================================

# ---------------------------------------------------------------------------
# LIFF (client-visible). One LIFF app per page; all share one LINE Login
# channel, so server verification uses LINE_LOGIN_CHANNEL_ID below.
# (danmaku covers photo upload too — merged page, 2026-07-05.)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LIFF_ID_RSVP=
NEXT_PUBLIC_LIFF_ID_DANMAKU=
NEXT_PUBLIC_LIFF_ID_RAFFLE=
NEXT_PUBLIC_LIFF_ID_ADMIN=

# ---------------------------------------------------------------------------
# LINE OA add-friend URL (client-visible). Used by the public landing's
# "add OA" CTA.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LINE_OA_ADD_FRIEND_URL=https://line.me/R/ti/p/@160vcltf

# ---------------------------------------------------------------------------
# RSVP backend (server-only). Apps Script web app URL. Treat as a secret —
# leak = anyone can append rows.
# ---------------------------------------------------------------------------
RSVP_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# LINE Messaging API (server-only) — placeholders for the future webhook.
# ---------------------------------------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# LIFF idToken verification (server-only). Set this to the LINE Login channel
# ID that hosts the LIFF apps above. Used by /api/danmaku, /api/photos*,
# /api/admin/*. Verification is done by POSTing to LINE's
# /oauth2/v2.1/verify endpoint.
# ---------------------------------------------------------------------------
LINE_LOGIN_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Admin allowlist (server-only). Comma-separated LIFF userId values for
# Zachary and Angelet. Anything else fails 403 on /api/admin/*.
# Get via /liff/admin's first load (it logs the userId to the console),
# or via the Messaging API webhook once it's wired.
# ---------------------------------------------------------------------------
ADMIN_LINE_USER_IDS=

# ---------------------------------------------------------------------------
# Screen page token (server-only). The /screen?token=<value> page is a
# public URL gated by this token; the API rejects feeds without a match.
# Pick a long random string. Rotate by changing it in the dashboard.
# ---------------------------------------------------------------------------
SCREEN_TOKEN=

# ---------------------------------------------------------------------------
# Danmaku keyword filter (server-only). Comma-separated. Hits land the
# message in 'pending' for admin review instead of 'approved'.
# ---------------------------------------------------------------------------
FORBIDDEN_WORDS=

# ---------------------------------------------------------------------------
# R2 S3-compatible access (server-only). Create at:
# Cloudflare dashboard > R2 > Manage R2 API tokens > Create API token
# with "Object Read & Write" on the wedding-photos bucket.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wedding-photos
# Optional: public R2 endpoint used in presigned URLs. Default works.
# Format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
