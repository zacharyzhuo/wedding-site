# =============================================================================
# wedding-site env vars
# Copy to .env.local for local dev. In production, set these in
# Cloudflare Pages > Settings > Environment variables.
# NEXT_PUBLIC_* are exposed to the browser (LIFF ID is not secret).
# Everything else is server-side only (Pages Functions).
# =============================================================================

# --- LIFF (client-visible) ---
# From LINE Developers > LINE Login channel > LIFF tab > rsvp app
NEXT_PUBLIC_LIFF_ID_RSVP=

# --- LINE OA add-friend URL (client-visible) ---
# Used by the public landing's "add OA" CTA.
NEXT_PUBLIC_LINE_OA_ADD_FRIEND_URL=https://line.me/R/ti/p/@160vcltf

# --- RSVP backend (server-only) ---
# Apps Script web app URL (Deploy > New deployment > Web app > Execute as: me,
# Access: anyone with link). Treat as a secret — leak = anyone can spam the Sheet.
RSVP_WEBHOOK_URL=

# --- LINE Messaging API (server-only) — placeholders for future webhook ---
# Get from LINE Developers > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
