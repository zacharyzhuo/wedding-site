{
  "name": "wedding-site",
  "version": "0.1.0",
  "private": true,
  "description": "卓育辰 ＆ 楊皖淩 · 2027-06-05 · LINE-central wedding site on Cloudflare Pages",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "pages:dev": "npm run build && npx wrangler pages dev .next/static --compatibility-date=2026-05-01",
    "pages:deploy": "npm run build && npx wrangler pages deploy out --project-name=wedding-site"
  },
  "dependencies": {
    "@line/liff": "^2.26.0",
    "aws4fetch": "^1.0.20",
    "next": "^15.5.18",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^3.95.0"
  }
}
